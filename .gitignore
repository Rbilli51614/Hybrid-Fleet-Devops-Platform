# Terraform
**/.terraform/*
.terraform.lock.hcl
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars
*.tfvars.json
!example.tfvars
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
.terragrunt-cache/

# Ansible
*.retry
inventories/*/host_vars/*secret*
inventories/*/group_vars/*secret*

# Secrets / local env
.env
.env.*
*.pem
*.key
!ansible/**/*.key.example

# Per-team ARC runner scale set values (kubernetes/eks/arc/README.md:
# copied from the .example.yaml per team/repo, not checked in here)
kubernetes/eks/arc/values-runner-scale-set.*.yaml
!kubernetes/eks/arc/values-runner-scale-set.example.yaml

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# Claude Code local settings (personal permission rules, not shared)
.claude/settings.local.json

# Kubeconfig
kubeconfig*
*.kubeconfig
