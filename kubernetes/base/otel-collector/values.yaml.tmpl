# Canonical OpenTelemetry Collector pipeline — the SAME shape installed on
# both tiers: terraform/modules/otel-collector (EKS, via Terraform's helm
# provider) renders this with templatefile(), and ansible/roles/
# otel-collector (VM tier, via kubernetes.core.helm over SSM) renders the
# same two placeholders through Jinja instead. Same receivers/processors/
# exporters/pipeline on both — only the two substituted values differ
# per environment. See docs/architecture.md.
#
# Placeholders (Terraform templatefile() / Ansible Jinja both use this
# exact spelling — do not rename without updating both):
#   ${amp_remote_write_url}   — terraform/modules/observability's amp_remote_write_url output
#   ${aws_region}             — the region the AMP workspace lives in

mode: deployment

# The chart requires this explicitly as of the pinned 0.108.0 (no default
# repository is baked in any more — a real apply failed outright with
# "[ERROR] 'image.repository' must be set" without it). This has to be the
# "contrib" image, not the chart's own default suggestion of the core
# otel/opentelemetry-collector image: sigv4auth and prometheusremotewrite,
# both used below, only ship in the contrib distribution.
image:
  repository: otel/opentelemetry-collector-contrib

config:
  receivers:
    hostmetrics:
      collection_interval: 60s
      scrapers:
        cpu: {}
        memory: {}
        disk: {}
        network: {}
        filesystem: {}

  processors:
    batch: {}

  exporters:
    prometheusremotewrite:
      endpoint: "${amp_remote_write_url}"
      auth:
        authenticator: sigv4auth

  extensions:
    # Also newly mandatory as of 0.108.0 — a real apply's second failure
    # ("chart requires that the health_check extension be included") once
    # image.repository was fixed. Standard liveness/readiness endpoint for
    # this chart, not something this pipeline otherwise needed.
    health_check: {}
    sigv4auth:
      region: "${aws_region}"
      service: "aps"

  service:
    extensions: [health_check, sigv4auth]
    pipelines:
      metrics:
        receivers: [hostmetrics]
        processors: [batch]
        exporters: [prometheusremotewrite]
